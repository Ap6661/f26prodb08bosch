extends layout

block content
  h1= title
  p Welcome to the changed #{title} page
  button(type="button", class="btn btn-primary", onClick="reduce()") Sample Button

  br 
  br 
  div#use 
    i take some away

  script.
    var current = 11;
    var quantity = 2;
    function reduce() {
      current = current - quantity;
      if (current < 0) {
        current = 0;
      }
      document.getElementById("use").innerHTML = `Reduced by ${quantity} to ${current}.`;
    }
