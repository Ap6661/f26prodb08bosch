extends layout

block content
  style(type="text/css").
    .col-sm-2 {
      color: black;
      background: white;
      margin: 1px;
      border-radius: 5px;
      word-wrap: break-word;
      border: 1px solid black;
    }
    .inner-row {
      color: black;
      background: white;
      margin: 3px;
      padding: 3px;
      border-radius: 5px;
      border: 1px solid black;
    }
  h1= title
  div.container-fluid
    div.row 
      each s, i in results
        div(onClick=`buy(${i})`).col-sm-2.text-center
          span #{s.name}
          div.inner-row Genus: #{s.genusName} 
          div.inner-row Teeth: #{s.numberOfTeeth} 
          div.inner-row Vertebrate: #{s.isVertebrate}

  script.
    function buy(y) {
      alert(`You Purchased ${y}!`)
    }
